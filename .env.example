# Application
APP_ENV=local
APP_AUTH_MODE=jwt
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
DATABASE_URL=sqlite:///./local_data/agentic_video_studio.sqlite3
CLOUD_SQL_PASSWORD=
STORAGE_ROOT=./local_data/media
PROVIDER_MODE=mock
LOG_LEVEL=INFO
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_NAME=Framewise
EMAIL_FROM_EMAIL=maksim@subschool.us
SENDPULSE_ID=
SENDPULSE_SECRET=
SENDPULSE_TEMPLATE_ID=266399
SENDPULSE_TEMPLATE_NAME=subschool_main
BOOTSTRAP_ADMIN_EMAIL=
SEED_DEMO_DATA=false
SIGNUP_CREDIT_TOKENS=1000

# Google Cloud / Gemini / Veo / TTS
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_RUNTIME_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-generate-001
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Achernar
GOOGLE_GENAI_USE_VERTEXAI=true

# Parallel Search
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_ENDPOINT=/v1/search

# YouTube OAuth / publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/connections/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REFRESH_TOKEN_SECRET=youtube-refresh-token
YOUTUBE_CHANNEL_ID=

# Optional analytics / observability
CLICKHOUSE_URL=
CLICKHOUSE_USER=avs
CLICKHOUSE_PASSWORD=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_HEADERS=
GRAFANA_URL=
GRAFANA_ADMIN_PASSWORD=

# Webhooks and security
WEBHOOK_SIGNING_SECRET=replace-in-local-env
API_KEY_PEPPER=replace-in-local-env
SECRET_ENCRYPTION_KEY=
APP_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_GRAFANA_URL=
